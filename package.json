{
  "name": "@seventwo-studio/block-editor",
  "version": "0.1.0",
  "description": "Framework-neutral block document model, markdown conversion, and CRDT operation layer for rich block editors.",
  "license": "MIT",
  "type": "module",
  "sideEffects": ["src/*.css"],
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seventwo-studio/block-editor.git"
  },
  "bugs": {
    "url": "https://github.com/seventwo-studio/block-editor/issues"
  },
  "homepage": "https://github.com/seventwo-studio/block-editor#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/react.css",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "block-editor",
    "crdt",
    "collaboration",
    "markdown",
    "rich-text"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "vite --host 127.0.0.1",
    "demo:dev": "vite --host 127.0.0.1",
    "demo:build": "vite build",
    "demo:preview": "vite preview --host 127.0.0.1",
    "demo:typecheck": "tsc -p tsconfig.demo.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "vite": "^7.3.2"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crdt": {
      "types": "./dist/crdt.d.ts",
      "import": "./dist/crdt.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react.css": "./src/react.css",
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "types": "./dist/index.d.ts"
}
