{
  "name": "@seventwo-studio/block-editor",
  "version": "0.1.0",
  "description": "Framework-neutral block document model, markdown conversion, and CRDT operation layer for rich block editors.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seventwo-studio/block-editor.git"
  },
  "bugs": {
    "url": "https://github.com/seventwo-studio/block-editor/issues"
  },
  "homepage": "https://github.com/seventwo-studio/block-editor#readme",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "block-editor",
    "crdt",
    "collaboration",
    "markdown",
    "rich-text"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "bun run test && bun run build"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "typescript": "^6.0.3"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crdt": {
      "types": "./dist/crdt.d.ts",
      "import": "./dist/crdt.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "types": "./dist/index.d.ts"
}
