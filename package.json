{
  "name": "@seventwo-studio/block-editor",
  "version": "0.2.0",
  "description": "Framework-neutral block document model, markdown conversion, and CRDT operation layer for rich block editors.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "src/*.css",
    "src/swift-modern.css"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seventwo-studio/block-editor.git"
  },
  "bugs": {
    "url": "https://github.com/seventwo-studio/block-editor/issues"
  },
  "homepage": "https://github.com/seventwo-studio/block-editor#readme",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.d.ts",
    "src/react.css",
    "README.md",
    "docs/shared-swift-editor.md",
    "docs/nested-collaboration.md",
    "LICENSE",
    "dist/block-editor.wasm",
    "dist/modern-provenance.json",
    "src/swift-modern.css",
    "docs/modern-editor-handoff.md"
  ],
  "keywords": [
    "block-editor",
    "crdt",
    "collaboration",
    "markdown",
    "rich-text"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun scripts/record-modern-build.mjs javascript",
    "dev": "vite --host 127.0.0.1",
    "demo:dev": "vite --host 127.0.0.1",
    "demo:build": "vite build",
    "demo:preview": "vite preview --host 127.0.0.1",
    "demo:typecheck": "tsc -p tsconfig.demo.json --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "prepublishOnly": "bun run test && bun run build",
    "check:package": "bun run build && bun scripts/check-package.mjs",
    "test:browser": "playwright test",
    "build:wasm": "sh scripts/build-wasm.sh",
    "build:android": "sh scripts/build-android.sh",
    "test:swift": "swift test",
    "demo:relay": "swift build --product editor-bridge && bun demo/relay/main.ts",
    "demo:stress": "bun demo/relay/stress.ts",
    "test:relay": "swift build --product editor-bridge && swift build --product relay-client && bun test tests/relay.test.ts tests/relay-recovery-limits.test.ts",
    "test:relay:browser": "swift build --product editor-bridge && swift build --product relay-client && playwright test --config playwright.relay.config.ts",
    "test:relay:restart": "playwright test --config playwright.relay-restart.config.ts",
    "typecheck:relay": "tsc -p tsconfig.relay.json",
    "test:wasm": "playwright test --config playwright.swift.config.ts",
    "test:relay:apple": "bun scripts/test-apple-relay.ts",
    "test:apple:ui": "bun scripts/test-apple-ui.ts",
    "test:android:recovery": "bun scripts/test-android-recovery.ts"
  },
  "dependencies": {
    "@bjorn3/browser_wasi_shim": "0.4.2",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@playwright/test": "1.63.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "typescript": "^6.0.3",
    "vite": "^8.0.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./crdt": {
      "types": "./dist/crdt.d.ts",
      "import": "./dist/crdt.js"
    },
    "./model": {
      "types": "./dist/model.d.ts",
      "import": "./dist/model.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./react.css": "./src/react.css",
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    },
    "./swift": {
      "types": "./dist/swift.d.ts",
      "import": "./dist/swift.js"
    },
    "./swift/react": {
      "types": "./dist/swift-react.d.ts",
      "import": "./dist/swift-react.js"
    },
    "./swift/modern": {
      "types": "./dist/swift-modern.d.ts",
      "import": "./dist/swift-modern.js"
    },
    "./swift/modern/react": {
      "types": "./dist/swift-modern-react.d.ts",
      "import": "./dist/swift-modern-react.js"
    },
    "./swift/modern/host": {
      "types": "./dist/swift-modern-host.d.ts",
      "import": "./dist/swift-modern-host.js"
    },
    "./swift/modern.css": "./src/swift-modern.css",
    "./swift/modern.wasm": "./dist/block-editor.wasm"
  },
  "types": "./dist/index.d.ts"
}
